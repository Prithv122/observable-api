# Copy to .env and fill in. Never commit .env.
# These are the variables this project actually reads (see src/observableapi/config.py).

# Redis — backs both the rate limiter and the response cache.
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Response cache
CACHE_TTL_SECONDS=30

# Logging: DEBUG | INFO | WARNING | ERROR. Renders human-readable when a TTY, JSON otherwise.
LOG_LEVEL=INFO

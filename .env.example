# Copy to .env and fill in. Never commit .env.
# These are every variable this project reads -- see src/observableapi/config.py.
# The Docker Compose stack sets its own values and does not need this file.

# Redis -- backs both the rate limiter and the response cache.
REDIS_URL=redis://localhost:6379/0

# Rate limiting. Budget is per client (X-API-Key when present, else source IP).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Response cache.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

# Logging. LOG_JSON=false renders human-readable lines instead of JSON.
LOG_LEVEL=INFO
LOG_JSON=true

# Where `observable-api build` writes the DuckDB warehouse, and where the API reads it.
WAREHOUSE_PATH=data/warehouse.duckdb
